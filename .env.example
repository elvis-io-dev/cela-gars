# ─── Ceļa Gars — Environment Variables ───────────────────────────────────────
# Copy this file to .env and fill in your keys.
# All VITE_ prefixed vars are exposed to the browser bundle.
# Never commit your real .env file to version control.

# Google Places API (New) — https://console.cloud.google.com/
# Enable: "Places API (New)" — used for location photos on route stops
VITE_GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# OpenAI API — https://platform.openai.com/api-keys
# Model used: gpt-4o-search-preview (web search for real-time Latvia events)
VITE_OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini API — https://aistudio.google.com/app/apikey
# Model used: gemini-2.0-flash with Google Search grounding (real-time events on Home page)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# OpenWeatherMap API — https://openweathermap.org/api
# Free tier works. Used for real Riga weather on Route Result page.
VITE_OPENWEATHER_API_KEY=your_openweather_api_key_here
